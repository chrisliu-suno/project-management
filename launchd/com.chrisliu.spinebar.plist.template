<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The menu bar app that shows what each running session is doing. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.chrisliu.spinebar</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/Applications/SpineBar.app/Contents/MacOS/SpineBar</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__HOME__/.local/state/spine/spinebar.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/state/spine/spinebar.log</string>
</dict>
</plist>
