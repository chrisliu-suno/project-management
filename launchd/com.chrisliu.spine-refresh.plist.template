<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hourly sweep: observe, classify what is new, index, propose. Runs through bin/run-refresh.sh
     because launchd gives a job no shell profile and the classify step needs the Anthropic key. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.chrisliu.spine-refresh</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/bin/run-refresh.sh</string>
  </array>

  <key>StartInterval</key>
  <integer>3600</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/.local/state/spine/refresh.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/state/spine/refresh.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:__HOME__/.local/bin</string>
  </dict>

  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>5</integer>
</dict>
</plist>
