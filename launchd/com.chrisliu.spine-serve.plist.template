<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The local dashboard. Restarted on a non-zero exit so a crash does not take it off the air
     until the next login. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.chrisliu.spine-serve</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/spine</string>
    <string>serve</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__HOME__/.local/state/spine/dashboard.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/state/spine/dashboard.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:__HOME__/.local/bin</string>
  </dict>

  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>5</integer>
</dict>
</plist>
